# ClusterLab Environment Configuration

# Server Port (defaults to 3000, compatible with Cloud Run / Railway / Heroku PORT)
PORT=3000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=production

# Optional Upstream Native llama-server URL (e.g. http://127.0.0.1:8080/v1)
# When set, chat completions can forward directly to local hardware execution
UPSTREAM_LLAMA_URL=""

# Public Client Configurations
VITE_APP_NAME=ClusterLab
