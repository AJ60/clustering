{
  "name": "clusterlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "silica": "tsx bin/silica.ts",
    "build:client": "tsc -b && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/__tests__/serverApi.test.ts src/__tests__/virtualEnvironmentsSmallModel.test.ts src/domain/__tests__/starClusterPlanner.test.ts src/__tests__/hybridTrinityGates.test.ts src/domain/__tests__/tensorCache.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
